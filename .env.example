# ─────────────────────────────────────────────────────────────
# 필수 (LLM 글쓰기) — 세 가지 중 하나
# ─────────────────────────────────────────────────────────────
# 방법 0) NVIDIA NIM (Nemotron) — 기본값. 가장 빠릅니다.
#   https://build.nvidia.com 에서 키 발급 (무료 크레딧 제공)
#   호출 왕복이 수 초라, 분·단위인 claude CLI 보다 운영 속도가 크게 다릅니다.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# 방법 A) Anthropic API 키 사용 (GitHub Actions 자동화에 필요)
ANTHROPIC_API_KEY=

# 방법 B) Claude 구독으로 실행 (API 키 불필요, 추가 과금 없음)
#   로컬:  claude 에 로그인만 되어 있으면 LLM_BACKEND=cli 로 바로 동작합니다.
#   CI:    `claude setup-token` 으로 1년짜리 토큰을 만들어 아래에 넣으세요.
#          GitHub Actions 에서는 저장소 Secret 에 CLAUDE_CODE_OAUTH_TOKEN 으로 등록합니다.
CLAUDE_CODE_OAUTH_TOKEN=

LLM_BACKEND=nvidia         # nvidia | api | cli
LLM_MODEL=claude-opus-5    # claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
LLM_FALLBACK_MODEL=claude-sonnet-5   # 안전 분류기 거절 시 대체 모델 (api 백엔드 전용)

# ─────────────────────────────────────────────────────────────
# 사이트 설정
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=AI 브리핑
NEXT_PUBLIC_ADSENSE_CLIENT=          # 예: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
NEXT_PUBLIC_GA_ID=                   # 예: G-XXXXXXXXXX
CONTACT_EMAIL=you@example.com

# ─────────────────────────────────────────────────────────────
# 소스 (선택 - 없으면 해당 소스만 건너뜁니다)
# ─────────────────────────────────────────────────────────────
# Reddit: 없어도 공개 JSON으로 동작하지만, 앱 등록 시 차단(429/403)이 훨씬 줄어듭니다.
#   https://www.reddit.com/prefs/apps 에서 "script" 앱 생성
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:ai-news-kr:v1.0 (by /u/yourname)

# Naver 검색 API: https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# X(Twitter) API v2 Bearer Token: https://developer.x.com  (유료 플랜 필요)
X_BEARER_TOKEN=

# Facebook Graph API Page Token (공개 검색 API는 폐지됨 - 지정 페이지 피드만 가능)
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_IDS=                   # 쉼표 구분, 예: MetaAI,OpenAI
